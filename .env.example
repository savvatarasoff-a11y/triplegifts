# Токен бота от @BotFather
BOT_TOKEN=
# Числовые ID админов через запятую (узнать у @userinfobot). Админ может выдавать чеки на звёзды
ADMIN_IDS=
# Путь к базе SQLite на Volume Railway
DB_PATH=/data/bot.db

# Необязательные
# Адрес мини-приложения. На Railway берётся автоматически из RAILWAY_PUBLIC_DOMAIN
WEBAPP_URL=
MIN_BET=1
MAX_BET=10000
# Стартовый бонус новым игрокам, звёзд
START_BONUS=0
LOG_LEVEL=INFO
