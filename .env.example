# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Ваш числовой Telegram ID (узнать у @userinfobot)
OWNER_ID=

# Необязательные настройки
# Модель Claude
CLAUDE_MODEL=claude-opus-5-5
# Имя, от которого бот пишет
OWNER_NAME=Савва
# Путь к базе SQLite. На Railway — путь внутри Volume
DB_PATH=/data/bot.db
# Задержка перед ответом, секунды
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=60
# Сколько минут бот молчит в чате после вашего сообщения
OWNER_PAUSE_MINUTES=30
# Уровень логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
